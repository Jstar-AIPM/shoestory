# ============================================================
# 「履历」环境配置 —— 复制成 .env 后填写（.env 已在 .gitignore，不会被提交）
#
# 写法要求：注释必须单独一行，不要写在取值后面（否则会被当成取值的一部分）。
# 密钥只在后端读取：不进前端、不进日志、不进仓库、不在界面回显。
# ============================================================

# ---------- 服务 ----------
# dev = 本地开发（会显示"高级：手动给一张源图"调试入口）；prod = 线上
ENV=dev
APP_HOST=127.0.0.1
# 8000/8080 已被其他项目占用，本项目固定用 8787
APP_PORT=8787
# DEBUG / INFO / WARNING
APP_LOG_LEVEL=INFO
# 数据目录（相对路径按仓库根目录解析）
DATA_DIR=./data

# ---------- 存储（阶段1 只实现 local；阶段4 部署到火山 TOS 时改 s3） ----------
# local | s3
STORAGE_PROVIDER=local

# 以下四项阶段 4 部署到火山对象存储 TOS 时才需要，阶段 1 留空
S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
S3_BUCKET=
S3_REGION=cn-beijing
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- 身份与邀请码（阶段4 线上；阶段1 留空即不启用） ----------
# 阶段4：逗号分隔的初始邀请码
INVITE_CODES=
# 阶段4：管理员码（不限次数、不过期、不可作废）；你自己的鞋柜挂在它下面
ADMIN_CODE=
# 空 = 不限制；仅作为邀请码外泄时的止血开关
GLOBAL_DAILY_GENERATE_LIMIT=
# 阶段1-3 的固定身份；阶段4 置空（改为「邀请码 -> owner_id」）
DEV_OWNER_ID=owner

# ============================================================
# 火山方舟（Ark）—— 真实模式需要下面 4 项
# 未填写时自动进入"演示模式"（mock 上游），链路完整可跑，但画稿是本地占位图
# ============================================================

# 【第 1 项】方舟 API Key
ARK_API_KEY=
# 【第 2 项】型号校对用模型（文本/多模态），填 endpoint id（ep-xxxx）或模型名
ARK_TEXT_MODEL=
# 【第 3 项】画稿质检用模型（视觉理解）
ARK_VISION_MODEL=
# 【第 4 项】图生图模型（Seedream，负责把鞋图画成黑白线稿）
ARK_IMAGE_MODEL=

ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT_SECONDS=300
ARK_MAX_RETRIES=2
# 型号校对/画稿质检都是确定性任务，不需要“深度思考”：关掉它可大幅降低延迟与成本
ARK_DISABLE_THINKING=true
# 送给视觉质检前把图片缩到长边不超过这个像素（原图太大又慢又贵，对质检无益）
ARK_MAX_IMAGE_EDGE=1024
# 生成速度：fast=约 30 秒（推荐）｜standard=约 80 秒、质量略高
# （官方 optimize_prompt_options.mode；fast 仅 Seedream 5.0 pro 支持，lite/4.5 不支持）
IMAGE_PROMPT_OPTIMIZE_MODE=fast
# 把“边缘骨架图”作为第二张参考图一起喂给图生图模型（锁结构、防止把鞋画变形）
ENABLE_STRUCTURE_REFERENCE=true

# ---------- 火山 · 豆包搜索（型号 -> 鞋图，文搜图） ----------
# volc_doubao | mock
SEARCH_PROVIDER=volc_doubao
# 官方地址（已核对，通常不用改）
VOLC_SEARCH_ENDPOINT=https://open.feedcoopapi.com/search_api/web_search
# <== 待填：豆包搜索（联网搜索）的 API Key，按量后付费那一个
VOLC_SEARCH_API_KEY=
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
SEARCH_MAX_IMAGES=5
SEARCH_REGION=cn-north-1

# ---------- 生成与质检 ----------
STYLE_ID=bw_lineart
# 每轮内部最多画几张：2 = 第 1 张若被判不合格会自动补画 1 张（用户仍只看到 1 张，不额外计额度）
# 想严格“只画 1 张”可设为 1（fast 模式偶发 Logo 崩坏时，用户会看到不合格提示）
# 每轮内部最多画几张：2 = 第 1 张被判不合格时自动补画 1 张（用户仍只看到 1 张、不额外计额度）
GEN_MAX_ATTEMPTS=2
# 质检通过阈值（PRD 已确认：0.80）
QUALITY_MIN_SCORE=0.80
# 画稿尺寸，固定 3:2
ARTWORK_WIDTH=1536
ARTWORK_HEIGHT=1024
# 单任务上游调用硬上限（成本护栏）
TASK_MAX_UPSTREAM_CALLS=10
# 型号置信度 >= 此值时，源图确认只展示 1 张推荐图（"就是这双"）；低于则展开多张让用户选
SOURCE_CONFIRM_CONFIDENCE=0.75
# 是否对候选源图做可用性预筛（单只/正侧面/背景干净）。文搜图多是资讯配图，不筛会把坏输入推给用户
ENABLE_SOURCE_SCREENING=true

# ---------- 降级与调试开关 ----------
# 是否允许"手动指定源图"兜底（仅 dev 生效）
ENABLE_MANUAL_SOURCE=true
# 无 Key 时用 mock 跑通链路（演示模式）；设为 false 则如实报"缺 Key"错误
ENABLE_MOCK_PROVIDER=true
# 即使有 Key 也强制走 mock（仅开发/测试用）
FORCE_MOCK_PROVIDER=false
# good = 质检高分通过；low = 故意低分，用于验证自动重试与"失败交用户裁决"
MOCK_QUALITY=good
# 允许的手动源图目录（逗号分隔）
ALLOWED_SOURCE_DIRS=./tmp/sources,./data/inbox
# true = 在请求内同步跑完流水线（仅测试用；线上必须 false）
PIPELINE_INLINE=false
